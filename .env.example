# =====================================================================
# Plugin Eventbooth — contoh konfigurasi.
# Salin berkas ini menjadi ".env" di root proyek, lalu isi nilainya.
# JANGAN pernah commit berkas .env asli ke Git.
# =====================================================================

APP_NAME="Plugin Eventbooth"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://plugin.eventbooth.id
APP_TIMEZONE=Asia/Makassar

# APP_KEY: kunci enkripsi untuk refresh token Google Drive dan
# Server Key Midtrans tenant yang disimpan di database.
# Isi string acak yang panjang (minimal 32 karakter), misalnya hasil
# acakan dari password manager. PERINGATAN: mengganti APP_KEY setelah
# data terenkripsi tersimpan membuat data lama tidak bisa dibaca.
APP_KEY=

# --- Database MySQL (dibuat dari panel hosting) ---
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Google OAuth (satu Google Cloud project milik platform) ---
# Redirect URI yang didaftarkan di Google Cloud Console harus persis:
#   https://plugin.eventbooth.id/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://plugin.eventbooth.id/auth/google/callback

# --- Midtrans PLATFORM (checkout lisensi; akun milik Super Admin) ---
# Server Key TIDAK BOLEH ada di aplikasi PC booth.
MIDTRANS_ENV=sandbox
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# --- Token bersama workflow n8n ---
# Dipakai n8n/aplikasi untuk memanggil /api/drive/* dan /api/session/*.
# Isi string acak panjang; nilai yang sama dipasang di kredensial n8n.
WORKFLOW_API_TOKEN=
